# Скопируйте этот файл в .env  (команда:  cp .env.example .env  или переименуйте вручную)
# и вставьте свой настоящий ключ OpenAI вместо sk-...
# Файл .env НИКОМУ не показывайте и не выкладывайте в интернет — это как пароль.

OPENAI_API_KEY=sk-ваш-ключ-openai-сюда

# Какую модель использовать. gpt-4o-mini — дешёвая и достаточная для парсинга.
# Можно поставить openai/gpt-4o для более сложных страниц (дороже).
OPENAI_MODEL=openai/gpt-4o-mini
